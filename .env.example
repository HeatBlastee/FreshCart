# Copy to .env and fill in values for local development:
#   cp .env.example .env
#   CONFIG_FILE=.env go run cmd/api/main.go
#
# In production (e.g. Render) these are set directly as real environment
# variables in the dashboard — this file is not deployed or read there.

environment=development
http_port=8888
grpc_port=8889
auth_secret=change-me-to-a-random-secret

database_uri=postgres://postgres:1234@localhost:5432/postgres?sslmode=disable

redis_uri=localhost:6379
redis_password=
redis_db=0

# CORS / rate limiting (optional — defaults: "*", 100 req / 60s)
cors_allowed_origins=*
rate_limit_requests=100
rate_limit_window_seconds=60

# Auth mode: "jwt" (default) or "oidc"
auth_mode=jwt

# OIDC / Authentik — only required when auth_mode=oidc
oidc_issuer=
oidc_client_id=
oidc_client_secret=
oidc_redirect_url=
oidc_jwks_url=
oidc_scopes=openid,email,profile
frontend_base_url=http://localhost:5173

# Headless Authentik (auth_mode=oidc only)
authentik_api_base=
authentik_admin_token=
authentik_flow_slug=freshcart-ropg

# Stripe — required for payments. webhook_secret comes from `stripe listen`
# or the dashboard; api_base is only set in tests to point at stripe-mock.
stripe_secret_key=sk_test_xxx
stripe_webhook_secret=whsec_xxx
stripe_publishable_key=pk_test_xxx
stripe_api_base=

# SMTP — required for transactional email (order receipts, etc.).
# In dev, point at MailHog: smtp_host=localhost, smtp_port=1025.
smtp_host=
smtp_port=25
smtp_user=
smtp_password=
email_from=no-reply@freshcart.local
